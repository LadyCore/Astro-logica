APP_NAME="Astro-lógica"
APP_ENV=local
APP_URL=http://127.0.0.1:8080
APP_DEBUG=true
APP_TIMEZONE=America/Argentina/Buenos_Aires

# FreeAstroAPI — put your key here (never commit .env)
# Dashboard: https://www.freeastroapi.com/ (API Key section)
# Empty = Cielo del día uses local mock data
FREEASTROAPI_KEY=
FREEASTROAPI_BASE_URL=https://api.freeastroapi.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=astro_logica
DB_USERNAME=root
DB_PASSWORD=
