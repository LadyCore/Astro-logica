APP_NAME="Astro-lógica"
APP_ENV=local
APP_URL=http://127.0.0.1:8080
APP_DEBUG=true
APP_TIMEZONE=America/Argentina/Buenos_Aires

# FreeAstroAPI — server-side only (never commit real .env)
# Put the key in .env as FREE_ASTRO_API_KEY (sent as x-api-key).
# Dashboard: https://www.freeastroapi.com/
# Docs map: https://www.freeastroapi.com/llms.txt
# Empty = Cielo del día uses local mock + "Datos demo · sin API key"
FREE_ASTRO_API_KEY=
FREEASTROAPI_KEY=
FREEASTROAPI_BASE_URL=https://api.freeastroapi.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=astro_logica
DB_USERNAME=root
DB_PASSWORD=
